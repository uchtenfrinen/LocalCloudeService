# Shared config for LocalCloudeStorage (git-ignored).
# Used by BOTH the client (setup.sh -> ~/.config/csc/.env) and the backend (deploy.sh).
# `setup.sh` creates this file automatically with a generated token; you normally
# don't edit it by hand. If your server already runs with a token, set STORAGE_TOKEN
# here before running setup.sh so the client and backend stay in sync.

STORAGE_URL=http://100.0.0.0:8080
STORAGE_TOKEN=
