# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it. `.env.example` is safe to commit.

STORAGE_PORT=8080
STORAGE_ROOT=./data

# Use a long random string, e.g. `openssl rand -hex 32`
STORAGE_TOKEN=change_me_to_a_long_random_string

# Optional: public base URL, if behind a reverse proxy
# STORAGE_BASE_URL=
